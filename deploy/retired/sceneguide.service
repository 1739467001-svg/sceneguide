# 🟥 已退役，勿用（2026-11-21 标注）🟥
# 现网跑 Docker Compose（deploy/kit-sg60/compose.yml），不用 systemd 裸机路径。
# 保留本文件仅作历史记录；如确需裸机部署，注意把 PORT 与 nginx 反代端口对齐
# （本文件与退役的 nginx.conf 在端口上互相矛盾：这里是 3000，那里写 3100）。
[Unit]
Description=SceneGuide - 三维问路（PAYATHON 2026 参赛作品）
After=network.target

[Service]
Type=simple
# 部署目录；如路径不同请同步修改 deploy.sh 里的 REMOTE_DIR
WorkingDirectory=/opt/sceneguide/scene-guide
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
User=sguser
Group=sguser

# 生产环境：使用 config/production.json + 生产网关
Environment=NODE_ENV=production
Environment=ALIPAY_ENV=production
Environment=PORT=3000
# 卖家展示名（收银台可见）
Environment=ALIPAY_SELLER_NAME=三维问路

# 安全基线
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/sceneguide/scene-guide/data

[Install]
WantedBy=multi-user.target
