{
  "name": "scene-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "三维问路 · 可被 Agent 自动购买的场景导览服务（A2M 智能收 / HTTP 402 按量付费）",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "smoke": "node scripts/test/smoke.js",
    "test": "node scripts/test/smoke.js && node scripts/test/test-deep.js && node scripts/test/test-deep2.js && node scripts/test/test-http.js",
    "test:smoke": "node scripts/test/smoke.js",
    "test:deep": "node scripts/test/test-deep.js",
    "test:deep2": "node scripts/test/test-deep2.js",
    "test:http": "node scripts/test/test-http.js",
    "verify": "bash scripts/verify.sh",
    "icons": "node scripts/build/make-icons.mjs",
    "trace": "node scripts/build/capture-protocol-trace.js && node scripts/build/capture-api-reference.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "alipay-sdk": "^4.14.0",
    "better-sqlite3": "13.2.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "three": "^0.187.0"
  }
}
